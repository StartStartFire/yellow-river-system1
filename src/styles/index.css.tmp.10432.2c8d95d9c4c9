@tailwind base;
@tailwind components;
@tailwind utilities;

/* 使用 :root:root（双倍 specificity）覆盖 Element Plus 默认 CSS 变量，不受 @layer 影响 */
:root:root {
  --el-bg-color: #112536;
  --el-bg-color-overlay: #0f1f33;
  --el-fill-color-blank: transparent;
  --el-fill-color: #0d1f36;
  --el-fill-color-light: #0f2340;
  --el-table-bg-color: #112536;
  --el-table-header-bg-color: #0a1a2e;
  --el-table-row-bg-color: #112536;
  --el-table-tr-bg-color: #112536;
  --el-border-color: #1a3a52;
  --el-border-color-light: #1a3a52;
  --el-border-color-lighter: #1a3a52;
  --el-border-color-extra-light: #1a3a52;
  --el-border-color-dark: #1a3a52;
  --el-input-bg-color: transparent;
}

@layer base {
  html {
    @apply bg-tech-bg text-tech-text;
  }

  body {
    @apply m-0 min-h-screen antialiased;
  }
}

/* Element Plus 深色主题覆盖 */
@layer components {
  .el-button {
    @apply border-tech-border bg-tech-card text-tech-text;
  }

  .el-button--primary {
    @apply bg-tech-primary border-tech-primary text-black;
  }

  .el-card {
    @apply bg-tech-card border-tech-border text-tech-text;
  }

  .el-table {
    @apply bg-tech-card text-tech-text;
  }

  .el-table th,
  .el-table tr {
    @apply bg-tech-card text-tech-text;
  }

  .el-table--striped .el-table__body tr.el-table__row--striped td {
    @apply bg-tech-bg;
  }

  .el-tabs__item {
    @apply text-tech-muted;
  }

  .el-tabs__item.is-active {
    @apply text-tech-primary;
  }

  .el-input__inner,
  .el-input__wrapper {
    @apply bg-tech-card border-tech-border text-tech-text;
  }

  .el-dialog {
    @apply bg-tech-card;
  }

  .el-dialog__title {
    @apply text-tech-text;
  }
}
